{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "APP_DISPLAY_MODE": "LAYOUT"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Optimized",
            "displayName": "G071 优化烧录模式（O2，保留调试符号）",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "APP_DISPLAY_MODE": "LAYOUT"
            }
        },
        {
            "name": "StatusDebug",
            "inherits": "Debug",
            "cacheVariables": {
                "APP_DISPLAY_MODE": "STATUS"
            }
        },
        {
            "name": "StatusOptimized",
            "inherits": "Optimized",
            "cacheVariables": {
                "APP_DISPLAY_MODE": "STATUS"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Optimized",
            "configurePreset": "Optimized"
        },
        {
            "name": "StatusDebug",
            "configurePreset": "StatusDebug"
        },
        {
            "name": "StatusOptimized",
            "configurePreset": "StatusOptimized"
        }
    ]
}
